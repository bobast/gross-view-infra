# Normalize line endings: text files get converted per platform default.
* text=auto

# Shell scripts MUST stay LF even on Windows (core.autocrlf=true):
# CRLF breaks BusyBox ash with "set: illegal option -" inside Linux containers.
*.sh text eol=lf

# The k8s entrypoint ConfigMap embeds the same shell script; CRLF would break
# the embedded script too (and its data.entrypoint.sh must stay byte-identical
# to opencode/entrypoint.sh).
k8s/base/opencode-entrypoint-configmap.yaml text eol=lf
k8s/base/opencode-deployment.yaml text eol=lf

# Vault shares the same pattern: vault/entrypoint.sh must stay byte-identical to
# data.entrypoint.sh in the vault-entrypoint ConfigMap.
vault/entrypoint.sh text eol=lf
vault/vault-config.hcl text eol=lf
k8s/base/vault-entrypoint-configmap.yaml text eol=lf
k8s/base/vault-deployment.yaml text eol=lf

# PowerShell scripts keep the native Windows CRLF form.
*.ps1 text eol=crlf