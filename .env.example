POSTGRES_DB_NAME=postgres
POSTGRES_DB_USER=root
POSTGRES_DB_PSWD=changeme

KC_DB_NAME=keycloak
KC_DB_USER=admin
KC_DB_PSWD=changeme

GV_DB_NAME=gross_view
GV_DB_USER=gvadmin
GV_DB_PSWD=changeme

KEYCLOAK_ADMIN=root
KEYCLOAK_ADMIN_PASSWORD=changeme

# gross-view-handler backend (NOT in docker: runs in debug mode on the host)
# nginx /api upstream -> host.docker.internal:8082
# Public Keycloak base URL; the handler derives the JWT issuer and token endpoint:
#   issuer      = ${KEYCLOAK_URL}/realms/gross-view-realm
#   token-uri   = ${KEYCLOAK_URL}/realms/gross-view-realm/protocol/openid-connect/token
KEYCLOAK_URL=https://gross-view.local/sso
# Mandatory (handler fails fast without it): AES-GCM key, 32 raw bytes as base64
CREDENTIAL_ENCRYPTION_KEY=changeme
# Confidential Keycloak client the handler backend uses for token exchange (RFC 8693)
# to issue per-session MCP tokens (audience "mcp"). Must match the
# "gross-view-handler-service" client in gross-view-realm.json.
KEYCLOAK_CLIENT_ID=gross-view-handler-service
KEYCLOAK_CLIENT_SECRET=changeme-gross-view-handler-service
OZON_CLIENT_ID=
OZON_API_KEY=

# OpenCode server (no server-side auth: the handler forwards the real user's JWT for
# attribution; the server runs on the internal network without its own credentials).
# The OpenCode server itself just needs an LLM provider key (set in the web UI or
# via env of the container); nothing here is shared with the handler anymore.
OPENCODE_DEFAULT_MODEL=deepseek/deepseek-flash
# LLM provider key for the opencode server container (passed through docker-compose
# as DEEPSEEK_API_KEY). The provider catalog expects exactly this env var name.
DEEPSEEK_API_KEY=
# Create llm_model entries missing in DB when syncing the OpenCode model catalog
# (POST /opencode/models/sync without createMissing param); the request param overrides.
OPENCODE_CATALOG_CREATE_MISSING=false

# OpenCode agent -> gross-view MCP (OAuth 2.0 RFC 9728, real user via Keycloak public client).
# Handler runs on the host, so the agent reaches it via host.docker.internal.
OPENCODE_MCP_URL=http://host.docker.internal:8082/api/mcp
# Pre-registered Keycloak PUBLIC client 'opencode-mcp' (redirect
# http://127.0.0.1:19876/mcp/oauth/callback). opencode runs the authorization-code flow
# (PKCE) as the REAL user; the resulting tokens persist in the opencode data volume
# (~/.local/share/opencode/mcp-auth.json). No service-account/client-credentials token is
# used anymore. One-time activation in the container:
#   opencode mcp auth gross-view
OPENCODE_MCP_CLIENT_ID=opencode-mcp
# OAuth scope to request. offline_access yields a refresh token good for the realm's
# offline session (30 days idle, no max lifespan); with only 'openid' the SSO session
# idles out after 30m (max 10h) and the MCP server drops back to needs_auth.
OPENCODE_MCP_SCOPE=openid offline_access

# HashiCorp Vault secrets engine (for the future External Secrets / ESO
# integration; not required by the current docker stack).
# Starts automatically: vault/entrypoint.sh initializes on the first boot and
# auto-unseals on every boot, so `docker compose up -d` is all that is needed.
# No required variables — defaults are built into the entrypoint:
#   VAULT_ADDR=http://127.0.0.1:8200
#   VAULT_CONFIG_FILE=/vault/config/vault-config.hcl
#   VAULT_DATA_DIR=/vault/data
# Kubernetes-auth role (only meaningful in K8s, see k8s/base/vault-*.yaml):
#   ESO_ROLE_NAME=eso-role
#   ESO_BOUND_SA_NAME=eso-vault-auth
#   ESO_BOUND_SA_NAMESPACE=gross-view
