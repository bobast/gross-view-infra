POSTGRES_DB_NAME=postgres
POSTGRES_DB_USER=root
POSTGRES_DB_PSWD=changeme

KC_DB_NAME=keycloak
KC_DB_USER=admin
KC_DB_PSWD=changeme

GV_DB_NAME=gross_view
GV_DB_USER=gvadmin
GV_DB_PSWD=changeme

KEYCLOAK_ADMIN=root
KEYCLOAK_ADMIN_PASSWORD=changeme

# gross-view-handler backend (NOT in docker: runs in debug mode on the host)
# nginx /api upstream -> host.docker.internal:8082
# Public Keycloak base URL; the handler derives the JWT issuer and token endpoint:
#   issuer      = ${KEYCLOAK_URL}/realms/gross-view-realm
#   token-uri   = ${KEYCLOAK_URL}/realms/gross-view-realm/protocol/openid-connect/token
KEYCLOAK_URL=https://gross-view.local/sso
# Mandatory (handler fails fast without it): AES-GCM key, 32 raw bytes as base64
CREDENTIAL_ENCRYPTION_KEY=changeme
OZON_CLIENT_ID=
OZON_API_KEY=

# OpenCode server (HTTP Basic auth for the handler Feign client).
# ЕДИНЫЙ источник правды: значение ОБЯЗАНО совпадать с окружением gross-view-handler
# (opencode.api.password) и с k8s-секретом gross-view-secrets/opencode_server_password,
# иначе сервер отвечает 401 (error.opencode.auth) на запросы handler-а.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=changeme
# Legacy fallback docker-compose: значение OPENCODE_PASSWORD используется только если
# OPENCODE_SERVER_PASSWORD не задан; задавайте предпочтительно OPENCODE_SERVER_PASSWORD.
OPENCODE_PASSWORD=changeme
OPENCODE_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# OpenCode agent -> gross-view MCP (deployed/shared agent, v1 service-account token)
# Handler runs on the host, so the agent reaches it via host.docker.internal.
OPENCODE_MCP_URL=http://host.docker.internal:8082/api/mcp
# client_credentials token of the opencode-agent service account. If left EMPTY,
# entrypoint.sh auto-generates it at container start from Keycloak credentials
# below (maximum automation). Pre-set it manually only to override auto-generation:
#   $token = .\scripts\get-opencode-mcp-token.ps1
OPENCODE_MCP_TOKEN=
# Internal (in-network, plain HTTP) Keycloak base URL used by entrypoint.sh for
# client_credentials token auto-generation (busybox wget in the image has no TLS).
# In docker it is http://keycloak:8080; in k8s http://keycloak.gross-view.svc.cluster.local:8080.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
OPENCODE_AGENT_CLIENT_ID=opencode-agent
OPENCODE_AGENT_CLIENT_SECRET=changeme-opencode-agent

DEEPSEEK_API_KEY=sk-...

# WireGuard VPN
# Public IP or domain name of the Docker host (used in generated peer configs).
# Set to "auto" to let the container detect the external IP automatically.
WG_SERVERURL=auto
# Number (or comma-separated names) of clients/peers to generate configs for.
WG_PEERS=5
# DNS served to VPN clients. 172.28.0.8 is the internal dnsmasq, so clients
# can resolve *.local service names without extra setup.
WG_PEERDNS=172.28.0.8
# Internal subnet for the WireGuard tunnel (only change on clash).
WG_INTERNAL_SUBNET=10.13.13.0
# User/Group ID owned by ./wireguard/config if using bind mount (optional).
PUID=1000
PGID=1000
# Token acquisition retries in the opencode entrypoint (default 10; reason is logged).
OPENCODE_TOKEN_MAX_ATTEMPTS=10
